# Copia este archivo como .env y cambia los valores antes de levantar en la nube.
RABBITMQ_USER=vidasalud
RABBITMQ_PASS=cambia-esta-clave
# Debe ser igual en ambos nodos para que puedan formar el clúster.
RABBITMQ_ERLANG_COOKIE=cambia-esta-cookie-secreta
# Pacientes simulados que reservan y cancelan horas en appointments (false para apagarlos).
DEMANDA_SIMULADA=true
# Contraseña de la base de datos de Supabase (Project Settings → Database).
DB_PASSWORD=pon-aqui-la-clave-de-supabase
# Kafka: host por el que los clientes externos llegan a los brokers (IP pública de la EC2 o localhost).
KAFKA_EXTERNAL_HOST=localhost
# Brokers para las apps dentro de Docker (por defecto ya apuntan a kafka1..kafka3).
# KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092,kafka3:29092
